    "import pandas as pd\n",
    "import numpy as np\n",
    "import string\n",
    "\n",
    "from sklearn.feature_extraction.text import (\n",
    "    TfidfVectorizer,\n",
    "    ENGLISH_STOP_WORDS\n",
    ")\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "\n",
    "\n",
    "train = pd.read_csv(\n",
    "    \"/kaggle/input/competitions/smart-mcq-solver-challenge/train.csv\"\n",
    ")\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"Dataset Shape:\", train.shape)\n",
    "print(\"=\"*60)\n",
    "\n",
    "\n",
    "\n",
    "answer_counts = train[\"answer\"].value_counts().sort_index()\n",
    "\n",
    "print(\"\\nQ1 - Answer Frequency Distribution\")\n",
    "print(answer_counts)\n",
    "\n",
    "q1 = answer_counts.max() + answer_counts.min()\n",
    "\n",
    "print(\"\\nANSWER Q1 =\", q1)\n",
    "\n",
    "\n",
    "translator = str.maketrans(\"\", \"\", string.punctuation)\n",
    "\n",
    "vocab = set()\n",
    "\n",
    "for text in train[\"prompt\"]:\n",
    "    cleaned = text.lower().translate(translator)\n",
    "    vocab.update(cleaned.split())\n",
    "\n",
    "q2 = len(vocab)\n",
    "\n",
    "print(\"\\nANSWER Q2 =\", q2)\n",
    "\n",
    "\n",
    "\n",
    "row1_prompt = train.iloc[0][\"prompt\"]\n",
    "\n",
    "cleaned_prompt = row1_prompt.lower().translate(translator)\n",
    "\n",
    "tokens = cleaned_prompt.split()\n",
    "\n",
    "filtered_tokens = [\n",
    "    word\n",
    "    for word in tokens\n",
    "    if word not in ENGLISH_STOP_WORDS\n",
    "]\n",
    "\n",
    "q3 = len(filtered_tokens)\n",
    "\n",
    "print(\"\\nANSWER Q3 =\", q3)\n",
    "\n",
    "\n",
    "\n",
    "combined_text = []\n",
    "\n",
    "for _, row in train.iterrows():\n",
    "\n",
    "    text = (\n",
    "        str(row[\"prompt\"]) + \" \" +\n",
    "        str(row[\"A\"]) + \" \" +\n",
    "        str(row[\"B\"]) + \" \" +\n",
    "        str(row[\"C\"]) + \" \" +\n",
    "        str(row[\"D\"]) + \" \" +\n",
    "        str(row[\"E\"])\n",
    "    )\n",
    "\n",
    "    combined_text.append(text)\n",
    "\n",
    "vectorizer = TfidfVectorizer(\n",
    "    stop_words=\"english\"\n",
    ")\n",
    "\n",
    "vectorizer.fit(combined_text)\n",
    "\n",
    "q4 = len(vectorizer.vocabulary_)\n",
    "\n",
    "print(\"\\nANSWER Q4 =\", q4)\n",
    "\n",
    "\n",
    "\n",
    "prompt_vec = vectorizer.transform(\n",
    "    [train.iloc[0][\"prompt\"]]\n",
    ")\n",
    "\n",
    "option_a_vec = vectorizer.transform(\n",
    "    [train.iloc[0][\"A\"]]\n",
    ")\n",
    "\n",
    "q5 = cosine_similarity(\n",
    "    prompt_vec,\n",
    "    option_a_vec\n",
    ")[0][0]\n",
    "\n",
    "print(\"\\nANSWER Q5 =\", round(q5, 4))\n",
    "\n",
    "\n",
    "\n",
    "correct = 0\n",
    "\n",
    "for _, row in train.iterrows():\n",
    "\n",
    "    prompt_vector = vectorizer.transform(\n",
    "        [row[\"prompt\"]]\n",
    "    )\n",
    "\n",
    "    scores = {}\n",
    "\n",
    "    for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n",
    "\n",
    "        option_vector = vectorizer.transform(\n",
    "            [row[option]]\n",
    "        )\n",
    "\n",
    "        score = cosine_similarity(\n",
    "            prompt_vector,\n",
    "            option_vector\n",
    "        )[0][0]\n",
    "\n",
    "        scores[option] = score\n",
    "\n",
    "    prediction = max(\n",
    "        scores,\n",
    "        key=scores.get\n",
    "    )\n",
    "\n",
    "    if prediction == row[\"answer\"]:\n",
    "        correct += 1\n",
    "\n",
    "q6 = (correct / len(train)) * 100\n",
    "\n",
    "print(\"\\nANSWER Q6 =\", round(q6, 2), \"%\")\n",
    "\n",
    "\n",
    "q7 = 1.0\n",
    "\n",
    "print(\"\\nANSWER Q7 =\", q7)\n",
    "\n",
    "\n",
    "q8 = 0.5\n",
    "\n",
    "print(\"\\nANSWER Q8 =\", q8)\n",
    "\n",
    "\n",
    "def map_at_3(actual, predictions):\n",
    "\n",
    "    for rank, pred in enumerate(\n",
    "        predictions[:3],\n",
    "        start=1\n",
    "    ):\n",
    "        if pred == actual:\n",
    "            return 1 / rank\n",
    "\n",
    "    return 0\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "freq_order = (\n",
    "    train[\"answer\"]\n",
    "    .value_counts()\n",
    "    .index\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "scores = []\n",
    "\n",
    "for actual in train[\"answer\"]:\n",
    "\n",
    "    prediction = freq_order[:3]\n",
    "\n",
    "    scores.append(\n",
    "        map_at_3(actual, prediction)\n",
    "    )\n",
    "\n",
    "q9 = np.mean(scores)\n",
    "\n",
    "print(\"\\nANSWER Q9 =\", round(q9, 6))\n",
    "\n",
    "\n",
    "\n",
    "scores = []\n",
    "\n",
    "for _, row in train.iterrows():\n",
    "\n",
    "    prompt_vector = vectorizer.transform(\n",
    "        [row[\"prompt\"]]\n",
    "    )\n",
    "\n",
    "    similarities = []\n",
    "\n",
    "    for option in [\"A\", \"B\", \"C\", \"D\", \"E\"]:\n",
    "\n",
    "        option_vector = vectorizer.transform(\n",
    "            [row[option]]\n",
    "        )\n",
    "\n",
    "        sim = cosine_similarity(\n",
    "            prompt_vector,\n",
    "            option_vector\n",
    "        )[0][0]\n",
    "\n",
    "        similarities.append(\n",
    "            (option, sim)\n",
    "        )\n",
    "\n",
    "    similarities.sort(\n",
    "        key=lambda x: x[1],\n",
    "        reverse=True\n",
    "    )\n",
    "\n",
    "    top3 = [\n",
    "        x[0]\n",
    "        for x in similarities[:3]\n",
    "    ]\n",
    "\n",
    "    scores.append(\n",
    "        map_at_3(\n",
    "            row[\"answer\"],\n",
    "            top3\n",
    "        )\n",
    "    )\n",
    "\n",
    "q10 = np.mean(scores)\n",
    "\n",
    "print(\"\\nANSWER Q10 =\", round(q10, 6))\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"FINAL ANSWERS\")\n",
    "print(\"=\"*60)\n",
    "print(\"Q1 =\", q1)\n",
    "print(\"Q2 =\", q2)\n",
    "print(\"Q3 =\", q3)\n",
    "print(\"Q4 =\", q4)\n",
    "print(\"Q5 =\", round(q5, 4))\n",
    "print(\"Q6 =\", round(q6, 2))\n",
    "print(\"Q7 =\", q7)\n",
    "print(\"Q8 =\", q8)\n",
    "print(\"Q9 =\", round(q9, 6))\n",
    "print(\"Q10 =\", round(q10, 6))"
   ]
  }
