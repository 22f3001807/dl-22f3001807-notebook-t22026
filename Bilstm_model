.Module):\n\n    def __init__(self, vocab_size):\n\n        super().__init__()\n\n        self.embedding = nn.Embedding(\n            vocab_size,\n            CFG.EMBEDDING_DIM,\n            padding_idx=0\n        )\n\n        self.lstm = nn.LSTM(\n            input_size=CFG.EMBEDDING_DIM,\n            hidden_size=CFG.HIDDEN_SIZE,\n            num_layers=CFG.NUM_LAYERS,\n            batch_first=True,\n            bidirectional=True,\n            dropout=CFG.DROPOUT\n        )\n\n        self.attention = Attention(CFG.HIDDEN_SIZE)\n\n        self.dropout = nn.Dropout(CFG.DROPOUT)\n\n        self.norm = nn.LayerNorm(CFG.HIDDEN_SIZE * 2)\n\n        self.classifier = nn.Linear(\n            CFG.HIDDEN_SIZE * 2,\n            1\n        )\n\n    def encode(self, x):\n\n        x = self.embedding(x)\n\n        output, _ = self.lstm(x)\n\n        output = self.attention(output)\n\n        output = self.norm(output)\n\n        output = self.dropout(output)\n\n        score = self.classifier(output)\n\n        return score\n\n    def forward(self, choices):\n\n        scores = []\n\n        for i in range(5):\n\n            option = choices[:, i]\n\n            score = self.encode(option)\n\n            scores.append(score)\n\n        scores = torch.cat(scores, dim=1)\n\n        return scores","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T10:00:12.136967Z","iopub.execute_input":"2026-07-30T10:00:12.137253Z","iopub.status.idle":"2026-07-30T10:00:12.150195Z","shell.execute_reply.started":"2026-07-30T10:00:12.137217Z","shell.execute_reply":"2026-07-30T10:00:12.149323Z"}},"outputs":[],"execution_count":44},{"cell_type":"code","source":"model = BiLSTMMCQ(\n    len(vocab)\n).to(CFG.DEVICE)\n\nprint(model)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-30T10:00:12.151232Z","iopub.execute_input":"2026-07-30T10:00:12.151568Z","iopub.status.idle":"2026-07-30T10:00:12.180342Z","shell.execute_reply.started":"2026-07-30T10:00:12.151536Z","s