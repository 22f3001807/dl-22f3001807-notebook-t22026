    ")\n",
    "\n",
    "text = \"Light-ion fusion is a technique.\"\n",
    "\n",
    "attention_inputs = tokenizer(\n",
    "    text,\n",
    "    return_tensors=\"pt\"\n",
    ")\n",
    "\n",
    "tokens = tokenizer.convert_ids_to_tokens(\n",
    "    attention_inputs[\"input_ids\"][0]\n",
    ")\n",
    "\n",
    "print(tokens)\n",
    "\n",
    "fusion_index = tokens.index(\"fusion\")\n",
    "\n",
    "attention_outputs = attention_model(**attention_inputs)\n",
    "\n",
    "attention_matrix = attention_outputs.attentions[-1][0, 0]\n",
    "\n",
    "print(\"Q8 =\", round(attention_matrix[0, fusion_index].item(), 4))"
