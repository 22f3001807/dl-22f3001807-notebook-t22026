    "from sentence_transformers import SentenceTransformer, util\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "import numpy as np\n",
    "\n",
    "model = SentenceTransformer(\"sentence-transformers/all-MiniLM-L6-v2\")\n",
    "\n",
    "prompt_embedding = model.encode(dataset[0][\"prompt\"], convert_to_tensor=True)\n",
    "option_b_embedding = model.encode(dataset[0][\"B\"], convert_to_tensor=True)\n",
    "\n",
    "similarity = util.cos_sim(prompt_embedding, option_b_embedding)\n",
    "\n",
    "print(\"Q9 =\", round(similarity.item(), 4))\n",
    "\n",
    "letters = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "\n",
    "tfidf_top3 = []\n",
    "minilm_top3 = []\n",
    "\n",
    "ap_scores = []\n",
    "\n",
    "for row in dataset:\n",
    "\n",
    "    docs = [row[\"prompt\"]] + [row[c] for c in letters]\n",
    "\n",
    "    vectorizer = TfidfVectorizer()\n",
    "\n",
    "    X = vectorizer.fit_transform(docs)\n",
    "\n",
    "    sims = cosine_similarity(X[0], X[1:])[0]\n",
    "\n",
    "    ranking = np.argsort(-sims)\n",
    "\n",
    "    tfidf_pred = [letters[i] for i in ranking[:3]]\n",
    "\n",
    "    tfidf_top3.append(tfidf_pred)\n",
    "\n",
    "    embeddings = model.encode(docs, convert_to_tensor=True)\n",
    "\n",
    "    sims = util.cos_sim(embeddings[0], embeddings[1:])[0].cpu().numpy()\n",
    "\n",
    "    ranking = np.argsort(-sims)\n",
    "\n",
    "    mini_pred = [letters[i] for i in ranking[:3]]\n",
    "\n",
    "    minilm_top3.append(mini_pred)\n",
    "\n",
    "    ans = row[\"answer\"]\n",
    "\n",
    "    if ans in mini_pred:\n",
    "        pos = mini_pred.index(ans)\n",
    "        if pos == 0:\n",
    "            ap_scores.append(1.0)\n",
    "        elif pos == 1:\n",
    "            ap_scores.append(0.5)\n",
    "        else:\n",
    "            ap_scores.append(1/3)\n",
    "    else:\n",
    "        ap_scores.append(0.0)\n",
    "\n",
    "map3 = np.mean(ap_scores)\n",
    "\n",
    "print(\"Q10 MAP@3 =\", round(map3, 6))\n",
    "\n",
    "count = 0\n",
    "\n",
    "for row, tfidf_pred, mini_pred in zip(dataset, tfidf_top3, minilm_top3):\n",
    "\n",
    "    ans = row[\"answer\"]\n",
    "\n",
    "    if ans not in tfidf_pred and ans in mini_pred:\n",
    "        count += 1\n",
    "\n",
    "print(\"Q10 Improvement Count =\", count)"
   ]
