    "!pip -q install transformers datasets sentence-transformers scikit-learn\n",
    "\n",
    "from datasets import load_dataset\n",
    "from transformers import AutoTokenizer\n",
    "\n",
    "dataset = load_dataset(\n",
    "    \"csv\",\n",
    "    data_files=\"/kaggle/input/competitions/smart-mcq-solver-challenge/train.csv\"\n",
    ")[\"train\"]\n",
    "\n",
    "dataset = dataset.map(\n",
    "    lambda x: {\n",
    "        \"combined_text\": x[\"prompt\"] + \" \" + x[\"A\"]\n",
    "    }\n",
    ")\n",
    "\n",
    "print(\"Q1 =\", len(dataset[51][\"combined_text\"]))\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(\"bert-base-uncased\")\n",
    "\n",
    "print(\"Q2 =\", tokenizer.vocab_size)\n",
    "\n",
    "print(\"Q3 =\", tokenizer.sep_token_id)\n",
    "\n",
    "prompts = [str(row[\"prompt\"]) for row in dataset]\n",
    "\n",
    "encoded = tokenizer(\n",
    "    prompts,\n",
    "    padding=\"max_length\",\n",
    "    truncation=True,\n",
    "    max_length=128,\n",
    "    return_tensors=\"pt\"\n",
    ")\n",
    "\n",
    "print(\"Q4 =\", encoded[\"input_ids\"].shape)"
   ]
