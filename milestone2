    "from transformers import pipeline\n",
    "\n",
    "classifier = pipeline(\n",
    "    \"zero-shot-classification\",\n",
    "    model=\"facebook/bart-large-mnli\"\n",
    ")\n",
    "\n",
    "result = classifier(\n",
    "    dataset[1][\"prompt\"],\n",
    "    candidate_labels=[\n",
    "        dataset[1][\"A\"],\n",
    "        dataset[1][\"B\"],\n",
    "        dataset[1][\"C\"]\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\"Q11 =\", round(result[\"scores\"][0], 4))\n",
    "\n",
    "softmax_sum = sum(result[\"scores\"])\n",
    "\n",
    "result2 = classifier(\n",
    "    dataset[1][\"prompt\"],\n",
    "    candidate_labels=[\n",
    "        dataset[1][\"A\"],\n",
    "        dataset[1][\"B\"],\n",
    "        dataset[1][\"C\"]\n",
    "    ],\n",
    "    multi_label=True\n",
    ")\n",
    "\n",
    "sigmoid_sum = sum(result2[\"scores\"])\n",
    "\n",
    "print(\"Q12 =\", round(abs(softmax_sum - sigmoid_sum), 4))\n",
    "\n",
    "from transformers import AutoTokenizer, AutoModelForSeq2SeqLM\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(\"google/flan-t5-small\")\n",
    "model = AutoModelForSeq2SeqLM.from_pretrained(\"google/flan-t5-small\")\n",
    "\n",
    "prompt = (\n",
    "    f\"Question: {dataset[0]['prompt']}. \"\n",
    "    f\"Is the correct answer A: {dataset[0]['A']} \"\n",
    "    f\"or B: {dataset[0]['B']}? \"\n",
    "    f\"Answer with just the letter A or B.\"\n",
    ")\n",
    "\n",
    "inputs = tokenizer(prompt, return_tensors=\"pt\")\n",
    "\n",
    "outputs = model.generate(\n",
    "    **inputs,\n",
    "    max_new_tokens=5\n",
    ")\n",
    "\n",
    "answer = tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
    "\n",
    "print(answer)"
   ]
  }
